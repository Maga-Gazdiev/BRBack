# Публичный HTTP-порт внутри контейнера. Прокси/хостинг должен направлять трафик сюда.
HTTP_ADDR=:8080
# Пути внутри backend-контейнера.
DATA_FILE=/app/data/content.json
UPLOAD_DIR=/app/data/uploads
# Сгенерировать: openssl rand -hex 32
ADMIN_TOKEN=
# Только для docker compose на сервере (внешний порт).
BACKEND_PUBLIC_PORT=8080
